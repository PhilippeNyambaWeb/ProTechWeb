SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailbox@protechweb.ca
SMTP_PASS=your_smtp_password

FROM_EMAIL=noreply@protechweb.ca
FROM_NAME=ProTechWeb

# Shared secret for Edge Function → relay authentication
RELAY_KEY=change_me

# HTTP server port
PORT=3000
RETURN_PATH=bounce@protechweb.ca

