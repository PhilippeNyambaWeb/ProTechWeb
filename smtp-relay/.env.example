SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailbox@protechweb.ca
SMTP_PASS=your_smtp_password

FROM_EMAIL=noreply@protechweb.ca
FROM_NAME=ProTechWeb

# Shared secret for Edge Function -> relay authentication
RELAY_KEY=change_me

# HTTP server port
PORT=3000
RETURN_PATH=bounce@protechweb.ca

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=protechweb
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=protechweb
DB_CONNECTION_LIMIT=5

# CORS allowlist (comma-separated origins or hostnames). Empty = allow all.
ALLOWED_ORIGINS=protechweb.ca,ava-r.ca

# Per-tenant SMTP passwords (use domain key in uppercase with non-alnum -> "_")
# Example: protechweb.ca -> PROTECHWEB_CA
NOREPLY_PASS__PROTECHWEB_CA=your_password_for_noreply@protechweb.ca
NOREPLY_PASS__AVA_R_CA=your_password_for_noreply@ava-r.ca

# Optional overrides
# NOREPLY_USER__PROTECHWEB_CA=noreply@protechweb.ca
